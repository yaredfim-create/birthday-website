<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Firtye! 🎉❤️</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            color: #ffffff;
            min-height: 100vh;
            text-align: center;
            padding: 20px 10px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        header {
            margin: 30px 0 20px 0;
        }

        h1 {
            font-size: 2.5rem;
            color: #ff7675;
            text-shadow: 0 0 15px rgba(255, 118, 117, 0.8);
            margin-bottom: 10px;
            animation: bounce 2s infinite;
        }

        p.subtitle {
            font-size: 1.2rem;
            color: #f1f2f6;
        }

        /* Music Button */
        .music-btn {
            background: #ff4757;
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(255, 71, 87, 0.4);
            margin: 15px 0 25px 0;
            transition: transform 0.2s ease;
        }

        .music-btn:hover {
            transform: scale(1.05);
        }

        .card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .message-box {
            font-size: 1.15rem;
            line-height: 1.8;
            text-align: left;
        }

        .section-title {
            font-size: 1.5rem;
            margin-bottom: 15px;
            color: #ff7675;
        }

        .media-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .media-grid img, .media-grid video {
            width: 100%;
            height: 380px;
            object-fit: cover;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            transition: transform 0.3s ease;
        }

        .media-grid img:hover, .media-grid video:hover {
            transform: scale(1.03);
        }

        footer {
            margin-top: 30px;
            font-size: 0.9rem;
            color: #dfe6e9;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <h1>Happy Birthday, Firtye! 🎂❤️</h1>
            <p class="subtitle">To my love, my everything / የኔ ውብ፣ የኔ ህይወት</p>
        </header>

        <!-- Music Section -->
        <audio id="bgMusic" loop>
            <source src="music.mp3" type="audio/mpeg">
        </audio>
        <button class="music-btn" onclick="playMusic()">🎵 Play / Pause Music</button>

        <!-- Romantic Wish Message -->
        <div class="card message-box">
            <p><strong>Happy Birthday my love, my everything! 🎉❤️</strong></p>
            <br>
            <p>ላንቺ ያለኝ ፍቅር ከቃላት በላይ ነው። You make my world so bright and full of happiness.</p>
            <br>
            <p>የኔ ውብ፣ የኔ ህይወት፣ እንኳን ተወለድሽልኝ! Wishing you a year filled with endless joy, peace, and all the love you deserve. Always stay as beautiful and amazing as you are.</p>
            <br>
            <p><strong>I love you so much! ❤️✨</strong></p>
        </div>

        <!-- Video Gallery (2 Videos) -->
        <div class="card">
            <h2 class="section-title">Special Moments 🎥</h2>
            <div class="media-grid">
                <video controls loop muted playsinline>
                    <source src="video1.mp4" type="video/mp4">
                    Your browser does not support video.
                </video>
                <video controls loop muted playsinline>
                    <source src="video2.mp4" type="video/mp4">
                    Your browser does not support video.
                </video>
            </div>
        </div>

        <!-- Photo Gallery (3 Photos) -->
        <div class="card">
            <h2 class="section-title">Photo Gallery 📸</h2>
            <div class="media-grid">
                <img src="photo1.jpg" alt="Firtye Photo 1">
                <img src="photo2.jpg" alt="Firtye Photo 2">
                <img src="photo3.jpg" alt="Firtye Photo 3">
            </div>
        </div>

        <footer>
            Made with ❤️ for Firtye
        </footer>
    </div>

    <script>
        function playMusic() {
            var audio = document.getElementById("bgMusic");
            if (audio.paused) {
                audio.play();
            } else {
                audio.pause();
            }
        }
    </script>
</body>
</html>
