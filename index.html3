<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Firtye! 🎉</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            color: #fff;
            min-height: 100vh;
            text-align: center;
            padding: 20px 10px;
        }

        header {
            margin-top: 20px;
            margin-bottom: 30px;
        }

        h1 {
            font-size: 2.5rem;
            color: #ff7675;
            text-shadow: 0 0 15px rgba(255, 118, 117, 0.6);
            margin-bottom: 10px;
            animation: pulse 2s infinite;
        }

        p.subtitle {
            font-size: 1.1rem;
            color: #dfe6e9;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        .card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }

        .message-box {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #fff;
            text-align: left;
        }

        .media-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .media-grid img, .media-grid video {
            width: 100%;
            height: 350px;
            object-fit: cover;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            transition: transform 0.3s ease;
        }

        .media-grid img:hover, .media-grid video:hover {
            transform: scale(1.03);
        }

        footer {
            margin-top: 40px;
            font-size: 0.9rem;
            color: #b2bec3;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <h1>Happy Birthday, Firtye! 🎂❤️</h1>
            <p class="subtitle">To my love, my everything / የኔ ውብ፣ የኔ ህይወት</p>
        </header>

        <!-- Romantic Wish Section -->
        <div class="card message-box">
            <p><strong>Happy Birthday my love, my everything! 🎉❤️</strong></p>
            <br>
            <p>ላንቺ ያለኝ ፍቅር ከቃላት በላይ ነው። You make my world so bright and full of happiness.</p>
            <br>
            <p>የኔ ውብ፣ የኔ ህይወት፣ እንኳን ተወለድሽልኝ! Wishing you a year filled with endless joy, peace, and all the love you deserve. Always stay as beautiful and amazing as you are.</p>
            <br>
            <p><strong>I love you so much! ❤️✨</strong></p>
        </div>

        <!-- Videos Section -->
        <div class="card">
            <h2>Special Moments 🎥</h2>
            <div class="media-grid">
                <video controls autoplay loop muted>
                    <source src="video1.mp4" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
                <video controls autoplay loop muted>
                    <source src="video2.mp4" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            </div>
        </div>

        <!-- Photos Section -->
        <div class="card">
            <h2>Photo Gallery 📸</h2>
            <div class="media-grid">
                <img src="photo1.jpg" alt="Firtye Photo 1">
                <img src="photo2.jpg" alt="Firtye Photo 2">
                <img src="photo3.jpg" alt="Firtye Photo 3">
            </div>
        </div>

        <footer>
            Made with ❤️ for Firtye
        </footer>
    </div>

</body>
</html>
